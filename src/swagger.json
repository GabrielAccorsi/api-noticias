{
  "openapi": "3.0.0",
  "info": {
    "title": "Aprendendo MERN API",
    "version": "1.0.0",
    "description": "API para criação de posts, registro de usuários e autenticação JWT.",
    "contact": {
      "name": "Gabriel Accorsi",
      "email": "gabrielpaccorsi@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://api-noticias-9c20.onrender.com",
      "description": "Servidor de produção"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor de desenvolvimento local"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Autenticação" },
    { "name": "User", "description": "Usuários" },
    { "name": "Post", "description": "Posts" },
    { "name": "Comment", "description": "Comentários" }
  ],
  "paths": {
    "/auth": {
      "post": {
        "summary": "Login do usuário",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthLoginRequest" },
              "example": {
                "email": "usuario@email.com",
                "password": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthLoginResponse" },
                "example": {
                  "message": "Login successful",
                  "data": {
                    "token": "jwt.token.aqui"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidCredentials"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/user": {
      "post": {
        "summary": "Cria um novo usuário",
        "tags": ["User"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreateRequest" },
              "example": {
                "name": "Gabriel",
                "username": "gaccorsi",
                "email": "gabriel@email.com",
                "password": "123456",
                "avatar": "avatar.png",
                "background": "background.jpg"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": {
                  "message": "User created successfuly",
                  "data": {
                    "id": "642f1c4b9f1b2e0012345678",
                    "name": "Gabriel",
                    "username": "gaccorsi",
                    "avatar": "avatar.png",
                    "background": "background.jpg"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Campos obrigatórios ausentes ou erro ao criar usuário",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingFields": {
                    "value": { "message": "Submit all filds for registration" }
                  },
                  "createError": {
                    "value": { "message": "Error creating user" }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "summary": "Lista usuários",
        "tags": ["User"],
        "responses": {
          "200": {
            "description": "Usuários retornados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserListResponse" },
                "example": {
                  "message": "Users fetched successfully",
                  "data": [
                    {
                      "id": "642f1c4b9f1b2e0012345678",
                      "name": "Gabriel",
                      "username": "gaccorsi",
                      "avatar": "avatar.png",
                      "background": "background.jpg"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "summary": "Busca um usuário pelo ID",
        "tags": ["User"],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "responses": {
          "200": {
            "description": "Usuário retornado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": {
                  "message": "User fetched successfully",
                  "data": {
                    "id": "642f1c4b9f1b2e0012345678",
                    "name": "Gabriel",
                    "username": "gaccorsi",
                    "avatar": "avatar.png",
                    "background": "background.jpg"
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID inválido, ausente ou usuário não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingId": {
                    "value": { "message": "Id is required" }
                  },
                  "invalidId": {
                    "value": { "message": "Invalid ID" }
                  },
                  "userNotFound": {
                    "value": { "message": "User not found" }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "summary": "Atualiza um usuário pelo ID",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserUpdateRequest" },
              "example": {
                "name": "Gabriel Novo",
                "username": "gaccorsi2",
                "avatar": "avatar2.png"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "User sucessfully updated" }
              }
            }
          },
          "400": {
            "description": "Token ausente/malformado, ID inválido, usuário não encontrado ou nenhum campo enviado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingFields": {
                    "value": { "message": "Submit at least one field for update" }
                  },
                  "invalidId": {
                    "value": { "message": "Invalid ID" }
                  },
                  "userNotFound": {
                    "value": { "message": "User not found" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falha de autenticação ou tentativa de atualizar outro usuário",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingAuthorization": {
                    "value": { "message": "Authorization header is missing" }
                  },
                  "invalidToken": {
                    "value": { "message": "Invalid token" }
                  },
                  "forbiddenUser": {
                    "value": { "message": "You can only update your own user" }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post": {
      "post": {
        "summary": "Cria um novo post",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PostCreateRequest" },
              "example": {
                "title": "Meu Post",
                "text": "Conteúdo do post",
                "banner": "banner.png"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post criado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "Post created successfully" }
              }
            }
          },
          "400": {
            "description": "Campos obrigatórios ausentes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "Subimit all fiends for registration" }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "summary": "Lista posts com paginação",
        "tags": ["Post"],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "description": "Quantidade de posts a pular."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 5 },
            "description": "Quantidade de posts a retornar."
          }
        ],
        "responses": {
          "200": {
            "description": "Posts retornados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostPaginatedResponse" },
                "example": {
                  "message": "Posts fetched successfully",
                  "data": [
                    {
                      "id": "642f1c4b9f1b2e0012345678",
                      "title": "Meu Post",
                      "text": "Conteúdo do post",
                      "banner": "banner.png",
                      "likes": [],
                      "comments": [],
                      "name": "Gabriel",
                      "userName": "gaccorsi",
                      "userAvatar": "avatar.png"
                    }
                  ],
                  "pagination": {
                    "total": 12,
                    "offset": 0,
                    "limit": 5,
                    "next": 5,
                    "previous": null
                  }
                }
              }
            }
          },
          "400": {
            "description": "Nenhum post encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "There are no posts yet :(" }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post/top": {
      "get": {
        "summary": "Lista posts populares",
        "tags": ["Post"],
        "responses": {
          "200": {
            "description": "Posts populares retornados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TopPostsResponse" },
                "example": {
                  "message": "Top posts fetched successfully",
                  "data": [
                    {
                      "id": "642f1c4b9f1b2e0012345678",
                      "title": "Post Popular",
                      "text": "Conteúdo muito curtido",
                      "banner": "banner.png",
                      "likes": [{ "userId": "642f1c4b9f1b2e0012345678", "created": "2025-08-18T08:00:00.000Z" }],
                      "likesCount": 1,
                      "comments": [],
                      "name": "Gabriel",
                      "userName": "gaccorsi",
                      "userAvatar": "avatar.png"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Nenhum post encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "There are no posts yet :(" }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post/search": {
      "get": {
        "summary": "Pesquisa posts pelo título",
        "tags": ["Post"],
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Texto usado para pesquisar o título dos posts."
          }
        ],
        "responses": {
          "200": {
            "description": "Posts encontrados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostListResponse" },
                "example": {
                  "message": "Posts fetched successfully",
                  "data": [
                    {
                      "id": "642f1c4b9f1b2e0012345678",
                      "title": "Meu Post",
                      "text": "Conteúdo do post",
                      "banner": "banner.png",
                      "likes": [],
                      "comments": [],
                      "name": "Gabriel",
                      "userName": "gaccorsi",
                      "userAvatar": "avatar.png"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Título ausente ou nenhum post encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingTitle": {
                    "value": { "message": "Title query is required" }
                  },
                  "notFound": {
                    "value": { "message": "There are no posts with this title" }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post/byUser": {
      "get": {
        "summary": "Lista posts do usuário autenticado",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Posts do usuário retornados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostListResponse" },
                "example": {
                  "message": "User posts fetched successfully",
                  "data": [
                    {
                      "id": "642f1c4b9f1b2e0012345678",
                      "title": "Meu Post",
                      "text": "Conteúdo do post",
                      "banner": "banner.png",
                      "likes": [],
                      "comments": [],
                      "name": "Gabriel",
                      "userName": "gaccorsi",
                      "userAvatar": "avatar.png"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Nenhum post encontrado para o usuário autenticado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "There are no posts from this user" }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post/{id}": {
      "get": {
        "summary": "Busca um post pelo ID",
        "tags": ["Post"],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "responses": {
          "200": {
            "description": "Post retornado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostResponse" },
                "example": {
                  "message": "Post fetched successfully",
                  "data": {
                    "id": "642f1c4b9f1b2e0012345678",
                    "title": "Meu Post",
                    "text": "Conteúdo do post",
                    "banner": "banner.png",
                    "likes": [],
                    "comments": [],
                    "name": "Gabriel",
                    "userName": "gaccorsi",
                    "userAvatar": "avatar.png"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "404": {
            "$ref": "#/components/responses/PostNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "summary": "Atualiza um post pelo ID",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PostUpdateRequest" },
              "example": {
                "title": "Título atualizado",
                "text": "Texto atualizado",
                "banner": "banner2.png"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "Post updated successfully" }
              }
            }
          },
          "400": {
            "description": "ID inválido ou nenhum campo enviado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "invalidId": {
                    "value": { "message": "Invalid ID" }
                  },
                  "missingFields": {
                    "value": { "message": "Subimit at least one fiend to update the post" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falha de autenticação ou usuário sem permissão para atualizar o post",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "invalidToken": {
                    "value": { "message": "Invalid token" }
                  },
                  "forbiddenPost": {
                    "value": { "message": "You can only update your own posts" }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/PostNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "summary": "Remove um post pelo ID",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "responses": {
          "200": {
            "description": "Post removido com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "Post deleted successfully" }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "description": "Falha de autenticação ou usuário sem permissão para remover o post",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "invalidToken": {
                    "value": { "message": "Invalid token" }
                  },
                  "forbiddenPost": {
                    "value": { "message": "You can only delete your own posts" }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/PostNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post/like/{id}": {
      "patch": {
        "summary": "Adiciona ou remove like de um post",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "responses": {
          "200": {
            "description": "Like alternado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "liked": {
                    "value": { "message": "Post liked successfully" }
                  },
                  "unliked": {
                    "value": { "message": "Post unliked successfully" }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/PostNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/post/comment/{id}": {
      "post": {
        "summary": "Adiciona comentário a um post",
        "tags": ["Comment"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddCommentRequest" },
              "example": {
                "comment": "Comentário legal!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comentário adicionado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "Comment added successfully" }
              }
            }
          },
          "400": {
            "description": "ID inválido ou texto do comentário ausente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "invalidId": {
                    "value": { "message": "Invalid ID" }
                  },
                  "missingComment": {
                    "value": { "message": "Comment text is required" }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/PostNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdPathParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "ID do recurso no formato ObjectId do MongoDB."
      }
    },
    "responses": {
      "InvalidCredentials": {
        "description": "Usuário ou senha inválidos",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "example": { "message": "User or password invalid" }
          }
        }
      },
      "Unauthorized": {
        "description": "Token ausente, malformado ou inválido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "examples": {
              "missingAuthorization": {
                "value": { "message": "Authorization header is missing" }
              },
              "invalidToken": {
                "value": { "message": "Invalid token" }
              }
            }
          }
        }
      },
      "InvalidId": {
        "description": "ID inválido ou ausente",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "examples": {
              "missingId": {
                "value": { "message": "Id is required" }
              },
              "invalidId": {
                "value": { "message": "Invalid ID" }
              }
            }
          }
        }
      },
      "PostNotFound": {
        "description": "Post não encontrado",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "example": { "message": "Post not found" }
          }
        }
      },
      "InternalServerError": {
        "description": "Erro interno do servidor",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "example": { "message": "Internal server error" }
          }
        }
      }
    },
    "schemas": {
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"]
      },
      "AuthLoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "usuario@email.com" },
          "password": { "type": "string", "example": "123456" }
        },
        "required": ["email", "password"]
      },
      "AuthLoginResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Login successful" },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string", "example": "jwt.token.aqui" }
            },
            "required": ["token"]
          }
        },
        "required": ["message", "data"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
          "name": { "type": "string", "example": "Gabriel" },
          "username": { "type": "string", "example": "gaccorsi" },
          "avatar": { "type": "string", "example": "avatar.png" },
          "background": { "type": "string", "example": "background.jpg" }
        },
        "required": ["id", "name", "username", "avatar", "background"]
      },
      "UserCreateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Gabriel" },
          "username": { "type": "string", "example": "gaccorsi" },
          "email": { "type": "string", "format": "email", "example": "gabriel@email.com" },
          "password": { "type": "string", "example": "123456" },
          "avatar": { "type": "string", "example": "avatar.png" },
          "background": { "type": "string", "example": "background.jpg" }
        },
        "required": ["name", "username", "email", "password", "avatar", "background"]
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Gabriel Novo" },
          "username": { "type": "string", "example": "gaccorsi2" },
          "email": { "type": "string", "format": "email", "example": "novo@email.com" },
          "password": { "type": "string", "example": "novaSenha123" },
          "avatar": { "type": "string", "example": "avatar2.png" },
          "background": { "type": "string", "example": "background2.jpg" }
        },
        "minProperties": 1
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/User" }
        },
        "required": ["message", "data"]
      },
      "UserListResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Users fetched successfully" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/User" }
          }
        },
        "required": ["message", "data"]
      },
      "PostCreateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Meu Post" },
          "text": { "type": "string", "example": "Conteúdo do post" },
          "banner": { "type": "string", "example": "banner.png" }
        },
        "required": ["title", "text", "banner"]
      },
      "PostUpdateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Título atualizado" },
          "text": { "type": "string", "example": "Texto atualizado" },
          "banner": { "type": "string", "example": "banner2.png" }
        },
        "minProperties": 1
      },
      "Like": {
        "type": "object",
        "properties": {
          "userId": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
          "created": { "type": "string", "format": "date-time", "example": "2025-08-18T08:00:00.000Z" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "idComment": { "type": "string", "example": "lq3hvx" },
          "userId": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
          "comment": { "type": "string", "example": "Muito bom!" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2025-08-18T08:00:00.000Z" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
          "title": { "type": "string", "example": "Meu Post" },
          "text": { "type": "string", "example": "Conteúdo do post" },
          "banner": { "type": "string", "example": "banner.png" },
          "likes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Like" }
          },
          "comments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Comment" }
          },
          "name": { "type": "string", "example": "Gabriel" },
          "userName": { "type": "string", "example": "gaccorsi" },
          "userAvatar": { "type": "string", "example": "avatar.png" }
        },
        "required": ["id", "title", "text", "banner", "likes", "comments", "name", "userName", "userAvatar"]
      },
      "PostResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Post fetched successfully" },
          "data": { "$ref": "#/components/schemas/Post" }
        },
        "required": ["message", "data"]
      },
      "PostListResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Post" }
          }
        },
        "required": ["message", "data"]
      },
      "TopPost": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
          "title": { "type": "string", "example": "Post Popular" },
          "text": { "type": "string", "example": "Conteúdo muito curtido" },
          "banner": { "type": "string", "example": "banner.png" },
          "likes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Like" }
          },
          "likesCount": { "type": "integer", "example": 1 },
          "comments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Comment" }
          },
          "name": { "type": "string", "example": "Gabriel" },
          "userName": { "type": "string", "example": "gaccorsi" },
          "userAvatar": { "type": "string", "example": "avatar.png" }
        },
        "required": ["id", "title", "text", "banner", "likes", "likesCount", "comments", "name", "userName", "userAvatar"]
      },
      "TopPostsResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Top posts fetched successfully" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TopPost" }
          }
        },
        "required": ["message", "data"]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "example": 12 },
          "offset": { "type": "integer", "example": 0 },
          "limit": { "type": "integer", "example": 5 },
          "next": { "type": "integer", "nullable": true, "example": 5 },
          "previous": { "type": "integer", "nullable": true, "example": null }
        },
        "required": ["total", "offset", "limit", "next", "previous"]
      },
      "PostPaginatedResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Posts fetched successfully" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Post" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        },
        "required": ["message", "data", "pagination"]
      },
      "AddCommentRequest": {
        "type": "object",
        "properties": {
          "comment": { "type": "string", "example": "Comentário legal!" }
        },
        "required": ["comment"]
      }
    }
  }
}
