{
  "openapi": "3.0.0",
  "info": {
    "title": "Aprendendo MERN API",
    "version": "1.0.0",
    "description": "API para o aplicativo Aprendendo MERN",
    "contact": {
      "name": "Gabriel Accorsi",
      "email": "gabrielpaccorsi@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de desenvolvimento local"
    }
  ],
  "paths": {
    "/auth/": {
      "post": {
        "summary": "Login do usuário",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "email": "usuario@email.com", "password": "123456" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso", "content": { "application/json": { "example": { "token": "jwt.token.aqui" } } } },
          "400": { "description": "Usuário ou senha inválidos", "content": { "application/json": { "example": { "message": "User or password invalid" } } } },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/user": {
      "post": {
        "summary": "Cria um novo usuário",
        "tags": ["User"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "example": { "name": "Gabriel", "username": "gaccorsi", "email": "gabriel@email.com", "password": "123456", "avatar": "avatar.png", "background": "background.jpg" } } }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso", "content": { "application/json": { "example": { "message": "User created successfully", "user": { "id": "642f1c4b9f1b2e0012345678", "name": "Gabriel", "username": "gaccorsi", "email": "gabriel@email.com", "avatar": "avatar.png", "background": "background.jpg" } } } } },
          "400": { "description": "Campos obrigatórios não enviados ou erro ao criar usuário" },
          "500": { "description": "Erro interno do servidor" }
        }
      },
      "get": {
        "summary": "Retorna todos os usuários",
        "tags": ["User"],
        "responses": {
          "200": { "description": "Lista de usuários", "content": { "application/json": { "example": [ { "id": "642f1c4b9f1b2e0012345678", "name": "Gabriel", "username": "gaccorsi", "email": "gabriel@email.com", "avatar": "avatar.png", "background": "background.jpg" } ] } } },
          "400": { "description": "Não há usuários registrados" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "summary": "Retorna um usuário pelo ID",
        "tags": ["User"],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "Usuário encontrado", "content": { "application/json": { "example": { "id": "642f1c4b9f1b2e0012345678", "name": "Gabriel", "username": "gaccorsi", "email": "gabriel@email.com", "avatar": "avatar.png", "background": "background.jpg" } } } },
          "400": { "description": "ID inválido ou usuário não encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      },
      "patch": {
        "summary": "Atualiza um usuário pelo ID",
        "tags": ["User"],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "example": { "name": "Gabriel Novo", "username": "gaccorsi2", "avatar": "avatar2.png" } } }
        },
        "responses": {
          "200": { "description": "Usuário atualizado com sucesso" },
          "400": { "description": "Nenhum campo enviado ou usuário não encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/post": {
      "post": {
        "summary": "Cria um novo post",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "example": { "title": "Meu Post", "text": "Conteúdo do post", "banner": "banner.png" } } }
        },
        "responses": {
          "201": { "description": "Post criado com sucesso" },
          "400": { "description": "Campos obrigatórios não enviados" },
          "500": { "description": "Erro interno do servidor" }
        }
      },
      "get": {
        "summary": "Retorna todos os posts com paginação",
        "tags": ["Post"],
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 5 } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Lista de posts", "content": { "application/json": { "example": { "nextUrl": "/post?limit=5&offset=5", "previousUrl": null, "limit": 5, "offset": 0, "total": 12, "results": [ { "id": "642f1c4b9f1b2e0012345678", "title": "Meu Post", "text": "Conteúdo do post", "banner": "banner.png", "likes": 2, "comments": 1, "name": "Gabriel", "userName": "gaccorsi", "userAvatar": "avatar.png", "commentsData": [ { "id": "c1d2e3f4", "userId": "642f1c4b9f1b2e0012345678", "userName": "gaccorsi", "userAvatar": "avatar.png", "comment": "Muito bom!", "createdAt": "2025-08-18T08:00:00Z" } ] } ] } } } },
          "400": { "description": "Não há posts" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/post/top": {
      "get": {
        "summary": "Retorna os posts mais populares",
        "tags": ["Post"],
        "responses": {
          "200": { "description": "Posts mais populares", "content": { "application/json": { "example": [ { "id": "642f1c4b9f1b2e0012345678", "title": "Post Popular", "text": "Conteúdo muito curtido", "banner": "banner.png", "likes": 10, "comments": 2, "name": "Gabriel", "userName": "gaccorsi", "userAvatar": "avatar.png" } ] } } },
          "400": { "description": "Não há posts" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/post/search": {
      "get": {
        "summary": "Pesquisa posts pelo título",
        "tags": ["Post"],
        "parameters": [ { "name": "title", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "Posts encontrados", "content": { "application/json": { "example": { "results": [ { "id": "642f1c4b9f1b2e0012345678", "title": "Meu Post", "text": "Conteúdo do post", "banner": "banner.png", "likes": 2, "comments": 1, "name": "Gabriel", "userName": "gaccorsi", "userAvatar": "avatar.png" } ] } } } },
          "400": { "description": "Não há posts com este título" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/post/byUser": {
      "get": {
        "summary": "Posts do usuário logado",
        "tags": ["Post"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Posts do usuário logado", "content": { "application/json": { "example": { "results": [ { "id": "642f1c4b9f1b2e0012345678", "title": "Meu Post", "text": "Conteúdo do post", "banner": "banner.png", "likes": 2, "comments": 1, "name": "Gabriel", "userName": "gaccorsi", "userAvatar": "avatar.png" } ] } } } },
          "400": { "description": "Não há posts deste usuário" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/post/{id}": {
      "get": { "summary": "Retorna um post pelo ID", "tags": ["Post"], "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Post encontrado", "content": { "application/json": { "example": { "id": "642f1c4b9f1b2e0012345678", "title": "Meu Post", "text": "Conteúdo do post", "banner": "banner.png", "likes": 2, "comments": 1, "name": "Gabriel", "userName": "gaccorsi", "userAvatar": "avatar.png" } } } }, "400": { "description": "ID inválido" }, "404": { "description": "Post não encontrado" }, "500": { "description": "Erro interno do servidor" } } },
      "patch": { "summary": "Atualiza um post pelo ID", "tags": ["Post"], "security": [{ "bearerAuth": [] }], "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ], "requestBody": { "required": true, "content": { "application/json": { "example": { "title": "Título atualizado", "text": "Texto atualizado", "banner": "banner2.png" } } } }, "responses": { "200": { "description": "Post atualizado com sucesso" }, "400": { "description": "Nenhum campo enviado" }, "401": { "description": "Você só pode atualizar seus próprios posts" }, "500": { "description": "Erro interno do servidor" } } },
      "delete": { "summary": "Deleta um post pelo ID", "tags": ["Post"], "security": [{ "bearerAuth": [] }], "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Post deletado com sucesso" }, "401": { "description": "Você só pode deletar seus próprios posts" }, "404": { "description": "Post não encontrado" }, "500": { "description": "Erro interno do servidor" } } }
    },
    "/post/like/{id}": {
      "patch": { "summary": "Dar like/unlike em um post", "tags": ["Post"], "security": [{ "bearerAuth": [] }], "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Post curtido/descurtido com sucesso" }, "404": { "description": "Post não encontrado" }, "500": { "description": "Erro interno do servidor" } } }
    },
    "/post/comment/{id}": {
      "post": { "summary": "Adicionar comentário a um post", "tags": ["Comment"], "security": [{ "bearerAuth": [] }], "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ], "requestBody": { "required": true, "content": { "application/json": { "example": { "comment": "Comentário legal!" } } } }, "responses": { "201": { "description": "Comentário adicionado com sucesso", "content": { "application/json": { "example": { "id": "c1d2e3f4", "userId": "642f1c4b9f1b2e0012345678", "userName": "gaccorsi", "userAvatar": "avatar.png", "comment": "Comentário legal!", "createdAt": "2025-08-18T08:00:00Z" } } } }, "404": { "description": "Post não encontrado" }, "500": { "description": "Erro interno do servidor" } } }
    },
    "/post/comment/{id}/{commentId}": {
      "delete": { "summary": "Deleta um comentário de um post", "tags": ["Comment"], "security": [{ "bearerAuth": [] }], "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Comentário deletado com sucesso" }, "401": { "description": "Você só pode deletar seus próprios comentários" }, "404": { "description": "Comentário ou post não encontrado" }, "500": { "description": "Erro interno do servidor" } } }
    }
  },
 "components": {
  "schemas": {
    "AuthLogin": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "example": "usuario@email.com" },
        "password": { "type": "string", "example": "123456" }
      },
      "required": ["email", "password"]
    },
    "AuthLoginResponse": {
      "type": "object",
      "properties": {
        "token": { "type": "string", "example": "jwt.token.aqui" }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
        "name": { "type": "string", "example": "Gabriel" },
        "username": { "type": "string", "example": "gaccorsi" },
        "email": { "type": "string", "example": "gabriel@email.com" },
        "avatar": { "type": "string", "example": "avatar.png" },
        "background": { "type": "string", "example": "background.jpg" }
      },
      "required": ["name", "username", "email", "password"]
    },
    "UserCreateRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "example": "Gabriel" },
        "username": { "type": "string", "example": "gaccorsi" },
        "email": { "type": "string", "example": "gabriel@email.com" },
        "password": { "type": "string", "example": "123456" },
        "avatar": { "type": "string", "example": "avatar.png" },
        "background": { "type": "string", "example": "background.jpg" }
      },
      "required": ["name", "username", "email", "password"]
    },
    "Post": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
        "title": { "type": "string", "example": "Meu Post" },
        "text": { "type": "string", "example": "Conteúdo do post" },
        "banner": { "type": "string", "example": "banner.png" },
        "likes": { "type": "integer", "example": 2 },
        "comments": { "type": "integer", "example": 1 },
        "name": { "type": "string", "example": "Gabriel" },
        "userName": { "type": "string", "example": "gaccorsi" },
        "userAvatar": { "type": "string", "example": "avatar.png" },
        "commentsData": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/Comment" }
        }
      }
    },
    "PostCreateRequest": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "example": "Meu Post" },
        "text": { "type": "string", "example": "Conteúdo do post" },
        "banner": { "type": "string", "example": "banner.png" }
      },
      "required": ["title", "text"]
    },
    "Comment": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "example": "c1d2e3f4" },
        "userId": { "type": "string", "example": "642f1c4b9f1b2e0012345678" },
        "userName": { "type": "string", "example": "gaccorsi" },
        "userAvatar": { "type": "string", "example": "avatar.png" },
        "comment": { "type": "string", "example": "Muito bom!" },
        "createdAt": { "type": "string", "format": "date-time", "example": "2025-08-18T08:00:00Z" }
      }
    },
    "PostPagination": {
      "type": "object",
      "properties": {
        "nextUrl": { "type": "string", "example": "/post?limit=5&offset=5" },
        "previousUrl": { "type": ["string", "null"], "example": null },
        "limit": { "type": "integer", "example": 5 },
        "offset": { "type": "integer", "example": 0 },
        "total": { "type": "integer", "example": 12 },
        "results": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/Post" }
        }
      }
    }
  },
  "securitySchemes": {
    "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
  }
}

}
